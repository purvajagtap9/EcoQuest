# Used by docker-compose.yml. Copy to .env in the project root before running `docker compose up`.

# Generate with: openssl rand -base64 64
JWT_SECRET=EcoQuestJWTSecret2026VeryLongRandomKey123

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# mock (default, no key needed) or gemini
AI_PROVIDER=mock
GEMINI_API_KEY=

# Where the frontend container will look for the backend at build+runtime
VITE_API_URL=http://localhost:8080
