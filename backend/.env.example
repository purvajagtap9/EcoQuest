# ==== MongoDB ====
# Local:  mongodb://localhost:27017/ecoquest
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ecoquest
MONGODB_URI=mongodb://localhost:27017/ecoquest

# ==== Server ====
SERVER_PORT=8080

# ==== JWT ====
# Generate a long random string for production, e.g.: openssl rand -base64 64
JWT_SECRET=replace-with-a-long-random-secret-value
JWT_EXPIRATION_MS=86400000

# ==== CORS ====
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ==== File storage ====
STORAGE_PROVIDER=local
FILE_STORAGE_PATH=./uploads
MAX_UPLOAD_SIZE=5MB

# ==== AI verification ====
# AI_PROVIDER=mock  -> works with no API key, returns simulated verification results
# AI_PROVIDER=gemini -> requires GEMINI_API_KEY
AI_PROVIDER=mock
GEMINI_API_KEY=

# ==== Quest geo validation ====
DEFAULT_GEO_RADIUS_METERS=500

# ==== Demo data ====
# Set true ONCE on a fresh/empty database to populate demo schools, users, topics, lessons,
# quizzes, quests, and badges (see backend/src/main/java/com/ecoquest/seed/DataSeeder.java for
# the full demo account list). Idempotent - skips automatically if data already exists.
SEED_DATA=false
